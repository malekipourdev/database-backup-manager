# Fernet key(s) used to encrypt stored database passwords. Required.
# Comma-separated: the first key encrypts, all keys decrypt (allows key rotation).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MBP_ENCRYPTION_KEY=

# Initial admin account. Only used on first start, when no admin exists yet.
MBP_ADMIN_USERNAME=admin
MBP_ADMIN_PASSWORD=

# Internal database URL. SQLite by default; PostgreSQL or MySQL by changing only this value:
#   postgresql+psycopg://user:pass@host:5432/mbp
#   mysql+pymysql://user:pass@host:3306/mbp
MBP_DATABASE_URL=sqlite:////data/mbp.db

# Address and port the panel is published on. The default 127.0.0.1 makes it reachable only
# from the server itself (use an SSH tunnel). Only change the address if a TLS reverse proxy
# or a trusted private network sits in front of the panel.
MBP_BIND_ADDRESS=127.0.0.1
MBP_HTTP_PORT=8080

# Maximum number of backups running at the same time; further ones wait in a queue.
# Backup files are stored in the mbp-backups volume, mounted at MBP_BACKUP_ROOT (/backups)
# inside the backend container.
MBP_BACKUP_CONCURRENCY=2

# Retention also runs after every backup; this is how often it runs for all backups (0 = off).
MBP_RETENTION_INTERVAL_MINUTES=60

# A schedule that fired while the panel was down still runs if the panel is back within this time.
MBP_SCHEDULE_MISFIRE_GRACE_SECONDS=300

# Send the session cookie only over HTTPS. Browsers accept it on http://localhost,
# but if you open the panel over plain HTTP from another machine, set this to false.
MBP_COOKIE_SECURE=true
